# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 环境配置（含密码，不入库）
backend/.env

# 模型权重与运行时文件
backend/weights/*.pt
backend/weights/*.onnx
backend/uploads/
backend/results/

# 前端
frontend/node_modules/      # 依赖包, npm install 可恢复
frontend/dist/              # 生产构建产物
frontend/dist-ssr/          # SSR 构建产物(不用 SSR 也顺手忽略)
frontend/coverage/          # 测试覆盖率报告
frontend/*.local            # Vite 本地环境变量(.env.development.local 等, 可能有敏感信息)
frontend/dev-dist/          # dev 移动端调试产物(若装 PWA 插件会生成)

# IDE / 系统
.vscode/
.idea/
.DS_Store

# 计划
PLAN.md

# 测试
backend/check
backend/testdata

# 部署 / 迁移产物
defect-images.tar           # docker save 导出的镜像整包(约12GB, 新机 docker load 用)
*.sql                       # mysqldump 数据库导出(dump.sql 等)

# 临时调试文件
*.py.bak
debug_*.py
